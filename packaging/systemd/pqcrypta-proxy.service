[Unit]
Description=PQCrypta Proxy - QUIC/HTTP3/WebTransport Proxy with PQC TLS
Documentation=https://github.com/PQCrypta/pqcrypta-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=pqcrypta
Group=pqcrypta

# Configuration
Environment=PQCRYPTA_CONFIG=/etc/pqcrypta/config.toml
Environment=PQCRYPTA_LOG_LEVEL=info
Environment=PQCRYPTA_JSON_LOGS=true

# Binary path
ExecStart=/usr/local/bin/pqcrypta-proxy --config ${PQCRYPTA_CONFIG}

# Reload configuration
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown (30 second timeout)
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed

# Restart policy
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=SIGTERM

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true

# Read: the configuration, keys and certificates. Written: what the proxy
# itself writes, each a directory of the proxy account's own: its logs, its
# state (observed fingerprints, crawler ranges), the certificates its ACME
# client renews and that client's account, and the conformance suite's ECN
# evidence. Root's files the proxy reads (blocklists, the JA3 list, ECH keys)
# are in root's directories, readable through the proxy's group: each
# directory has one writer.
ReadOnlyPaths=/etc/letsencrypt
ReadOnlyPaths=/etc/pqcrypta
ReadWritePaths=/var/log/pqcrypta-proxy
ReadWritePaths=/var/lib/pqcrypta-proxy/state
ReadWritePaths=/etc/pqcrypta/certs
ReadWritePaths=/etc/pqcrypta/acme
ReadWritePaths=-/var/lib/pqcrypta/conformance/ecn-evidence

# Network capabilities
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

# Working directory
WorkingDirectory=/var/lib/pqcrypta-proxy

# Standard output/error
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pqcrypta-proxy

[Install]
WantedBy=multi-user.target
