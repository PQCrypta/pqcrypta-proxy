[Unit]
Description=PQCrypta Proxy - QUIC/HTTP3/WebTransport Proxy with PQC TLS
# With pqcrypta-proxy.socket (`pqcrypta-proxy --socket-unit`), enabled, the
# service manager holds the listening sockets across a restart; this unit
# needs no change for it (README, Systemd).
Documentation=https://github.com/PQCrypta/pqcrypta-proxy
After=network-online.target
Wants=network-online.target

[Service]
# The proxy tells the service manager when it is serving, reloading and
# stopping, and pings its watchdog (src/service_notify.rs): `systemctl reload`
# returns once the reload is done, and a proxy whose runtime hangs is
# restarted. notify-reload needs systemd 253 or later (Debian 13, Ubuntu
# 24.04); with an older one, use Type=notify and the ExecReload line below.
Type=notify-reload
WatchdogSec=30s
#ExecReload=/bin/kill -HUP $MAINPID
User=pqcrypta
Group=pqcrypta

# Configuration
Environment=PQCRYPTA_CONFIG=/etc/pqcrypta/config.toml
Environment=PQCRYPTA_LOG_LEVEL=info
Environment=PQCRYPTA_JSON_LOGS=true

# Binary path
ExecStart=/usr/local/bin/pqcrypta-proxy --config ${PQCRYPTA_CONFIG}

# Graceful shutdown: longer than server.graceful_shutdown_timeout_secs (30 s),
# the proxy's own budget for draining, so the drain is never killed at the
# moment it would have finished
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=mixed

# Restart policy
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=SIGTERM

# Memory, as fractions of the host's: above MemoryHigh the kernel reclaims
# from the proxy and slows it, at MemoryMax it stops it alone (and Restart=
# brings it back) instead of choosing a victim among the host's other
# services. The proxy itself sheds load before either (src/memory_pressure.rs).
MemoryHigh=20%
MemoryMax=30%
MemorySwapMax=256M

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryDenyWriteExecute=true
LockPersonality=true
SystemCallArchitectures=native
# What a network service calls; anything else fails with EPERM rather than
# killing the process, so an unexpected call is an error in the log
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Read: the configuration, keys and certificates. Written: what the proxy
# itself writes, each a directory of the proxy account's own: its logs, its
# state (observed fingerprints, crawler ranges), the certificates its ACME
# client renews and that client's account, and the conformance suite's ECN
# evidence. Root's files the proxy reads (blocklists, the JA3 list, ECH keys)
# are in root's directories, readable through the proxy's group: each
# directory has one writer.
ReadOnlyPaths=-/etc/letsencrypt
ReadOnlyPaths=/etc/pqcrypta
ReadWritePaths=/var/log/pqcrypta-proxy
ReadWritePaths=/var/lib/pqcrypta-proxy/state
ReadWritePaths=/etc/pqcrypta/certs
ReadWritePaths=/etc/pqcrypta/acme
ReadWritePaths=-/var/lib/pqcrypta/conformance/ecn-evidence

# Network capabilities
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

# Working directory
WorkingDirectory=/var/lib/pqcrypta-proxy

# Standard output/error
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pqcrypta-proxy

[Install]
WantedBy=multi-user.target
