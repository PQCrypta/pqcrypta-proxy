[Unit]
Description=PQCrypta delegated credentials — the certificate the proxy delegates from (RFC 9345), renewed before it runs out
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pqcrypta-delegated-credential-cert
StandardOutput=journal
StandardError=journal
# As the proxy's account, which keeps its own certificates: it writes the
# delegating certificate into the proxy's certificate directory and asks the
# proxy, on its loopback admin API, to reload. The private CA that signs it is
# this unit's own state directory (CA_DIR), which nothing else reads.
User=pqcrypta
Group=pqcrypta
UMask=0077
StateDirectory=pqcrypta-delegation-ca
StateDirectoryMode=0700
ReadWritePaths=/etc/pqcrypta/certs
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
